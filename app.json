{
  "expo": {
    "name": "AI Assistant",
    "slug": "tinchodoko-ai-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.tinchodoko.aiassistant",
      "versionCode": 1,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070B1D"
      }
    },
    "plugins": [
      "./plugins/withImmersiveMode"
    ],
    "icon": "./assets/icon.png"
  }
}
